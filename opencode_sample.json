{
  "$schema": "https://opencode.ai/config.json",
  "model": "kaggle/gyro-s-strata",
  "provider": {
    "kaggle": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kaggle T4 Tunnel",
      "options": {
        "baseURL": "{env:STRATA_BASE_URL}",
        "apiKey": "{env:STRATA_API_KEY}"
      },
      "models": {
        "gyro-s-strata": {
          "name": "Gyro-S (Strata)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3-coder-30b": {
          "name": "Qwen3-Coder-30B-A3B-Instruct (llama.cpp)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
